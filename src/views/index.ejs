<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <title>Pokémon Team Builder</title>
   <link rel="stylesheet" href="styles.css">
</head>
<body>
   <div class="full-content">
     <h1 class="title">Pokémon Team Builder</h1>
     <div class="header-links">
	<a class="navigation-link" href="/">Browse Pokémon</a>
	<a class="navigation-link" href="/team">My Team</a>
     </div>
     <div id="main-content">
        <div id="search-and-results">
           <input type="text" id="search" placeholder="Search Pokémon...">
           <div id="results">
           </div>
        </div>

		  <div class="select-and-credits">
			  <div id="selected-pokemon"></div>
			  <div id="credits">
				  Made by NickW16
				  <a href="https://github.com/NickW16" target="_blank">
						<img src="images/github-mark-white.png" alt="github credits" id="github-image">
				  </a>
			  </div>
			</div>
     </div>
   </div>

  <script type='module' src="/js/search.js"></script>
</body>
</html>
